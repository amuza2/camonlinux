<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:camonlinux.ViewModels"
        xmlns:models="using:camonlinux.Models"
        xmlns:local="using:camonlinux.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="600"
        x:Class="camonlinux.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/webcam.ico"
        Title="camonlinux"
        Width="960" Height="600"
        MinWidth="640" MinHeight="480"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        SizeChanged="OnWindowSizeChanged">

    <Window.KeyBindings>
        <KeyBinding Gesture="Space" Command="{Binding TakePhotoCommand}"/>
        <KeyBinding Gesture="R" Command="{Binding ToggleRecordingCommand}"/>
        <KeyBinding Gesture="B" Command="{Binding ToggleBurstCommand}"/>
        <KeyBinding Gesture="M" Command="{Binding ToggleMirrorCommand}"/>
        <KeyBinding Gesture="E" Command="{Binding ToggleEffectsPanelCommand}"/>
        <KeyBinding Gesture="F11" Command="{Binding ToggleFullScreenCommand}"/>
    </Window.KeyBindings>

    <DockPanel Background="Black">

        <!-- Top toolbar -->
        <Border DockPanel.Dock="Top" Padding="10,8" Background="#202020">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <ToggleButton IsChecked="{Binding Mirrored}"
                                  ToolTip.Tip="Mirror the camera view">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#x21C4;"/>
                            <TextBlock Text="Mirror"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ShowTimestamp}"
                                  ToolTip.Tip="Stamp photos &amp; videos with the date and time">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#x1F552;"/>
                            <TextBlock Text="Stamp"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding IsMaskEnabled}" Click="OnMaskToggled"
                                  ToolTip.Tip="Enable masking and open the Mask Editor">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#x1F3AD;"/>
                            <TextBlock Text="Mask"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding IsVirtualCamEnabled}" Click="OnVirtualCamToggled"
                                  ToolTip.Tip="Share the preview as a virtual webcam (needs the v4l2loopback module)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#x1F3A5;"/>
                            <TextBlock Text="Webcam"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button Command="{Binding RefreshDevicesCommand}" ToolTip.Tip="Scan for cameras">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#x21BB;"/>
                            <TextBlock Text="Devices"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenMediaFolderCommand}" ToolTip.Tip="Open the photos folder">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#x1F4C2;"/>
                            <TextBlock Text="Folder"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#x2699;"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              PlaceholderText="Select a camera"
                              Width="240"
                              DisplayMemberBinding="{Binding Name}"/>
                    <ComboBox ItemsSource="{Binding Resolutions}"
                              SelectedItem="{Binding SelectedResolution}"
                              Width="130"
                              ToolTip.Tip="Capture resolution (per camera)"/>
                    <ComboBox ItemsSource="{Binding RotationOptions}"
                              SelectedItem="{Binding SelectedRotation}"
                              Width="64"
                              ToolTip.Tip="Rotate the image"/>
                    <ComboBox ItemsSource="{Binding ZoomOptions}"
                              SelectedItem="{Binding SelectedZoom}"
                              Width="64"
                              ToolTip.Tip="Digital zoom"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Camera controls (brightness / contrast / saturation / advanced) -->
        <Border DockPanel.Dock="Top" Padding="12,6" Background="#181818">
            <StackPanel Orientation="Vertical" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Bright" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
                        <Slider Value="{Binding Brightness}" Minimum="0" Maximum="255" Width="140"/>
                        <TextBlock Classes="slider-value" Text="{Binding Brightness, StringFormat='{}{0}'}"
                                   ToolTip.Tip="Brightness (0-255)"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Contrast" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
                        <Slider Value="{Binding Contrast}" Minimum="0" Maximum="255" Width="140"/>
                        <TextBlock Classes="slider-value" Text="{Binding Contrast, StringFormat='{}{0}'}"
                                   ToolTip.Tip="Contrast (0-255)"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Saturation" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
                        <Slider Value="{Binding Saturation}" Minimum="0" Maximum="255" Width="140"/>
                        <TextBlock Classes="slider-value" Text="{Binding Saturation, StringFormat='{}{0}'}"
                                   ToolTip.Tip="Saturation (0-255)"/>
                    </StackPanel>
                    <ToggleButton IsChecked="{Binding ShowAdvancedControls}" Content="More"
                                  ToolTip.Tip="Show additional camera controls (white balance, exposure, focus, …)"
                                  VerticalAlignment="Center"/>
                    <Button Content="Reset" Command="{Binding ResetCameraControlsCommand}" VerticalAlignment="Center"
                            ToolTip.Tip="Reset camera controls to defaults"/>
                </StackPanel>

                <!-- Advanced controls, shown only for devices that expose them -->
                <StackPanel Orientation="Horizontal" Spacing="24" IsVisible="{Binding ShowAdvancedControls}">
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowSharpness}">
                        <TextBlock Text="Sharp" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
                        <Slider Value="{Binding Sharpness}" Minimum="0" Maximum="255" Width="110"/>
                        <TextBlock Classes="slider-value" Text="{Binding Sharpness, StringFormat='{}{0}'}"
                                   ToolTip.Tip="Sharpness (0-255)"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowWhiteBalance}">
                        <TextBlock Text="WBalance" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
                        <ToggleButton IsChecked="{Binding WhiteBalanceAuto}" Content="Auto" Padding="10,2"/>
                        <Slider Value="{Binding WhiteBalanceTemperature}" Minimum="2000" Maximum="7500" Width="130"
                                IsEnabled="{Binding !WhiteBalanceAuto}"
                                ToolTip.Tip="White balance temperature (K)"/>
                        <TextBlock Classes="slider-value" Text="{Binding WhiteBalanceTemperature, StringFormat='{}{0}'}"
                                   IsEnabled="{Binding !WhiteBalanceAuto}"
                                   ToolTip.Tip="White balance temperature (K)"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowExposure}">
                        <TextBlock Text="Exposure" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
                        <ToggleButton IsChecked="{Binding ExposureAuto}" Content="Auto" Padding="10,2"/>
                        <Slider Value="{Binding ExposureValue}" Minimum="3" Maximum="2047" Width="130"
                                IsEnabled="{Binding !ExposureAuto}"
                                ToolTip.Tip="Exposure time"/>
                        <TextBlock Classes="slider-value" Text="{Binding ExposureValue, StringFormat='{}{0}'}"
                                   IsEnabled="{Binding !ExposureAuto}"
                                   ToolTip.Tip="Exposure time"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowFocus}">
                        <TextBlock Text="Focus" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
                        <ToggleButton IsChecked="{Binding FocusAuto}" Content="Auto" Padding="10,2"/>
                        <Slider Value="{Binding FocusValue}" Minimum="0" Maximum="255" Width="130"
                                IsEnabled="{Binding !FocusAuto}"
                                ToolTip.Tip="Manual focus distance"/>
                        <TextBlock Classes="slider-value" Text="{Binding FocusValue, StringFormat='{}{0}'}"
                                   IsEnabled="{Binding !FocusAuto}"
                                   ToolTip.Tip="Manual focus distance"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowGain}">
                        <TextBlock Text="Gain" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
                        <Slider Value="{Binding Gain}" Minimum="0" Maximum="255" Width="110"/>
                        <TextBlock Classes="slider-value" Text="{Binding Gain, StringFormat='{}{0}'}"
                                   ToolTip.Tip="Gain (0-255)"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowBacklight}">
                        <TextBlock Text="Backlight" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
                        <Slider Value="{Binding BacklightCompensation}" Minimum="0" Maximum="1" Width="110"/>
                        <TextBlock Classes="slider-value" Text="{Binding BacklightCompensation, StringFormat='{}{0}'}"
                                   ToolTip.Tip="Backlight compensation (0 = off, 1 = on)"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Right panel: captures / effects. Drag its left edge to resize it. -->
        <Border DockPanel.Dock="Right" Width="{Binding RightPanelWidth}" Background="#202020">
            <DockPanel>
            <!-- Resize grip. The panel is docked to the right, so dragging the grip
                 left widens it and dragging right narrows it; double-clicking
                 restores the default width.

                 Deliberately a plain Border and not a Thumb: Thumb calls
                 PointerPressedEventArgs.PreventGestureRecognition(), so a native
                 DoubleTapped would never reach it. -->
            <Border DockPanel.Dock="Left" Width="6" Cursor="SizeWestEast"
                    Classes="resize-grip" Background="Transparent"
                    PointerPressed="OnPanelResizeGripPressed"
                    PointerMoved="OnPanelResizeGripMoved"
                    PointerReleased="OnPanelResizeGripReleased"
                    DoubleTapped="OnPanelResizeReset"
                    ToolTip.Tip="Drag left or right to resize this panel — double-click to reset"/>

            <Grid>
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="8,10,8,6" ColumnDefinitions="*,*" ColumnSpacing="6">
                    <ToggleButton Grid.Column="0" Content="Captures" IsChecked="{Binding !ShowEffectsPanel}"/>
                    <ToggleButton Grid.Column="1" Content="Effects" IsChecked="{Binding ShowEffectsPanel}"/>
                </Grid>

                <StackPanel DockPanel.Dock="Top" Margin="8,0,8,4" Spacing="2"
                            IsVisible="{Binding ShowIntensitySlider}">
                    <TextBlock Text="Effect intensity" Foreground="#CCCCCC" FontSize="12"/>
                    <Slider Value="{Binding EffectIntensity}"
                            Minimum="{Binding SelectedEffect.IntensityMin}"
                            Maximum="{Binding SelectedEffect.IntensityMax}"
                            Width="220"/>
                </StackPanel>

                <TextBox DockPanel.Dock="Top" Margin="8,0,8,4" PlaceholderText="Search effects…"
                         Text="{Binding EffectFilter}" IsVisible="{Binding ShowEffectsPanel}"/>

                <StackPanel DockPanel.Dock="Top" Margin="8,0,8,4" Orientation="Horizontal" Spacing="4"
                            IsVisible="{Binding !ShowEffectsPanel}">
                    <ComboBox ItemsSource="{Binding GalleryFilterOptions}" SelectedItem="{Binding SelectedGalleryFilter}" Width="70"/>
                    <ComboBox ItemsSource="{Binding GallerySortOptions}" SelectedItem="{Binding SelectedGallerySort}" Width="92"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="8" Spacing="6"
                            IsVisible="{Binding !ShowEffectsPanel}">
                    <Button Content="Play video" Command="{Binding PlaySelectedCommand}"/>
                    <Button Content="Delete" Command="{Binding DeleteSelectedCommand}"/>
                </StackPanel>

                <!-- Effects gallery: always two columns, with the tiles growing as the
                     panel is widened (rather than packing in more, smaller previews). -->
                <ListBox ItemsSource="{Binding FilteredEffects}"
                         SelectedItem="{Binding SelectedEffect}"
                         IsVisible="{Binding ShowEffectsPanel}"
                         Background="Transparent" Margin="4,0,4,8">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Half the panel per tile, guaranteed. The ListBox's
                                 ScrollViewer measures with unlimited height, so each cell
                                 still sizes to its content instead of stretching down. -->
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:EffectOption">
                            <Border CornerRadius="4" Margin="3" Background="#40000000"
                                    BorderBrush="#33FFFFFF" BorderThickness="1">
                                <Grid RowDefinitions="Auto,Auto">
                                    <Grid Grid.Row="0">
                                        <!-- Stretch=Uniform (not UniformToFill): the image
                                             takes the width the tile is given and derives
                                             its height from the aspect ratio, so nothing
                                             is cropped. MinHeight keeps a placeholder
                                             while the preview is still rendering. -->
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                               MinHeight="44" HorizontalAlignment="Stretch"/>
                                        <ToggleButton IsChecked="{Binding IsFavorite}" Content="★"
                                                      FontSize="11" Width="24" Height="20" Padding="0"
                                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                                      Margin="2" ToolTip.Tip="Favorite — pin to the top">
                                            <ToggleButton.Styles>
                                                <Style Selector="ToggleButton">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </Style>
                                                <Style Selector="ToggleButton:unchecked">
                                                    <Setter Property="Foreground" Value="#B0B0B0"/>
                                                </Style>
                                                <Style Selector="ToggleButton:checked">
                                                    <Setter Property="Foreground" Value="#FFD700"/>
                                                </Style>
                                            </ToggleButton.Styles>
                                        </ToggleButton>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding Name}" HorizontalAlignment="Center"
                                               FontSize="12" Margin="0,2"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Recent captures -->
                <ListBox ItemsSource="{Binding GalleryItems}"
                         SelectedItem="{Binding SelectedGalleryItem}"
                         SelectionMode="Multiple"
                         SelectionChanged="OnGallerySelectionChanged"
                         DoubleTapped="OnGalleryDoubleTapped"
                         IsVisible="{Binding !ShowEffectsPanel}"
                         Background="Transparent" Margin="4,0,4,8">
                    <ListBox.Styles>
                        <!-- Make each row span the panel, so the selection highlight and
                             hit area cover the full width rather than just the content. -->
                        <Style Selector="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:MediaItem">
                            <!-- Auto/* columns: the thumbnail keeps the width the panel
                                 affords and the text takes what is left, so dragging
                                 the panel wider grows the previews and the file name
                                 instead of leaving a strip of empty space. -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="4,3">
                                <Border Grid.Column="0" CornerRadius="3" ClipToBounds="True"
                                        Background="#40000000" VerticalAlignment="Center">
                                    <!-- Width/Height follow the panel; the Min/Max pair both
                                         caps the growth and keeps a usable size if the
                                         size lookup ever fails to resolve. -->
                                    <Image Source="{Binding Thumbnail}"
                                           MinWidth="64" MinHeight="36" MaxWidth="160" MaxHeight="90"
                                           Width="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).GalleryThumbWidth}"
                                           Height="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).GalleryThumbHeight}"
                                           Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ModifiedAt, StringFormat='{}{0:MMM d, HH:mm}'}"
                                               FontSize="10" Foreground="#A0A0A0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <TextBlock Text="No captures yet — take a photo or record a video."
                       Foreground="#888888" FontSize="12" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14"
                       IsVisible="{Binding ShowGalleryEmptyHint}"/>
            </Grid>
            </DockPanel>
        </Border>

        <!-- Capture controls (Photo / Video tabs) -->
        <Border DockPanel.Dock="Bottom" Padding="10" Background="#202020">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14">
                <TextBlock Text="{Binding RecordingTime}" FontSize="16" FontFamily="monospace"
                           Foreground="#FF5252" IsVisible="{Binding IsRecording}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding RecordingSize}" FontSize="14" Foreground="#FF8A80"
                           IsVisible="{Binding IsRecording}" VerticalAlignment="Center"/>

                <!-- Mode tabs -->
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="2" VerticalAlignment="Center">
                    <ToggleButton Grid.Column="0" Content="Photo" IsChecked="{Binding !IsVideoMode}" Padding="14,4"/>
                    <ToggleButton Grid.Column="1" Content="Video" IsChecked="{Binding IsVideoMode}" Padding="14,4"/>
                </Grid>

                <!-- Photo mode controls -->
                <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="{Binding !IsVideoMode}">
                    <Button Content="Take Photo" Command="{Binding TakePhotoCommand}"
                            FontSize="15" Padding="20,8" VerticalAlignment="Center"/>
                    <Button Content="{Binding BurstButtonText}" Command="{Binding ToggleBurstCommand}"
                            FontSize="15" Padding="20,8" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Timer" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding TimerOptions}" SelectedItem="{Binding SelectedTimer}"
                                  Width="74" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Format" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding PhotoFormatOptions}" SelectedItem="{Binding SelectedPhotoFormat}"
                                  Width="68" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Video mode controls -->
                <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="{Binding IsVideoMode}">
                    <Button Content="{Binding RecordButtonText}" Command="{Binding ToggleRecordingCommand}"
                            FontSize="15" Padding="20,8" VerticalAlignment="Center"/>
                    <ToggleButton IsChecked="{Binding MicEnabled}" VerticalAlignment="Center"
                                  ToolTip.Tip="Record audio from the microphone">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#x1F3A4;"/>
                            <TextBlock Text="Mic"/>
                        </StackPanel>
                    </ToggleButton>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Audio" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding SelectedAudioDevice}"
                                  Width="180" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Quality" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding SelectedQuality}"
                                  Width="86" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Max size" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding MaxSizeOptions}" SelectedItem="{Binding SelectedMaxSize}"
                                  Width="132" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Preview area -->
        <Grid>
            <local:VideoSurface x:Name="VideoSurfaceControl" PointerWheelChanged="OnPreviewWheel" SizeChanged="OnPreviewSizeChanged"/>

            <!-- Draggable mask-position handle (shown while masking is on). -->
            <Canvas IsHitTestVisible="True">
                <Ellipse x:Name="MaskHandle" Width="18" Height="18"
                         Fill="#66FFFFFF" Stroke="White" StrokeThickness="2"
                         IsVisible="{Binding IsMaskEnabled}" IsHitTestVisible="True"
                         Cursor="SizeAll"
                         PointerPressed="OnMaskHandlePressed"
                         PointerMoved="OnMaskHandleMoved"
                         PointerReleased="OnMaskHandleReleased"/>
            </Canvas>

            <!-- Busy overlay (centred) and the status message below it occupy the same
                 spot, so they are mutually exclusive — see ShowStatusMessage. -->
            <Border Background="#80000000" CornerRadius="6" Padding="14,8"
                    IsVisible="{Binding IsBusy}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding BusyText}" Foreground="White"/>
            </Border>
            <TextBlock Text="{Binding StatusMessage}" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding ShowStatusMessage}"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="32"
                       MaxWidth="480"/>
            <TextBlock Text="{Binding CountdownText}" FontSize="96" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding IsCountingDown}">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="12" OffsetX="0" OffsetY="0" Opacity="0.9"/>
                </TextBlock.Effect>
            </TextBlock>
            <!-- White flash on photo capture -->
            <Border Background="White" IsVisible="{Binding IsFlashing}" IsHitTestVisible="False"/>

            <!-- Toast notification -->
            <Border Background="#E0222222" CornerRadius="6" Padding="16,10"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                    IsVisible="{Binding IsToastVisible}" IsHitTestVisible="False">
                <TextBlock Text="{Binding ToastText}" Foreground="White" FontSize="14"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
