<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:camonlinux.ViewModels"
        xmlns:models="using:camonlinux.Models"
        xmlns:local="using:camonlinux.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="600"
        x:Class="camonlinux.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="camonlinux"
        Width="960" Height="600"
        MinWidth="640" MinHeight="480"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <KeyBinding Gesture="Space" Command="{Binding TakePhotoCommand}"/>
        <KeyBinding Gesture="R" Command="{Binding ToggleRecordingCommand}"/>
        <KeyBinding Gesture="B" Command="{Binding ToggleBurstCommand}"/>
        <KeyBinding Gesture="M" Command="{Binding ToggleMirrorCommand}"/>
        <KeyBinding Gesture="E" Command="{Binding ToggleEffectsPanelCommand}"/>
        <KeyBinding Gesture="F11" Command="{Binding ToggleFullScreenCommand}"/>
    </Window.KeyBindings>

    <DockPanel Background="Black">

        <!-- Top toolbar -->
        <Border DockPanel.Dock="Top" Padding="10,8" Background="#202020">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <ToggleButton IsChecked="{Binding Mirrored}"
                                  ToolTip.Tip="Mirror the camera view">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#x21C4;"/>
                            <TextBlock Text="Mirror"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ShowTimestamp}"
                                  ToolTip.Tip="Stamp photos &amp; videos with the date and time">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#x1F552;"/>
                            <TextBlock Text="Stamp"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button Command="{Binding RefreshDevicesCommand}" ToolTip.Tip="Scan for cameras">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#x21BB;"/>
                            <TextBlock Text="Devices"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenMediaFolderCommand}" ToolTip.Tip="Open the photos folder">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#x1F4C2;"/>
                            <TextBlock Text="Folder"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#x2699;"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              PlaceholderText="Select a camera"
                              Width="240"
                              DisplayMemberBinding="{Binding Name}"/>
                    <ComboBox ItemsSource="{Binding Resolutions}"
                              SelectedItem="{Binding SelectedResolution}"
                              Width="130"
                              ToolTip.Tip="Capture resolution (per camera)"/>
                    <ComboBox ItemsSource="{Binding RotationOptions}"
                              SelectedItem="{Binding SelectedRotation}"
                              Width="64"
                              ToolTip.Tip="Rotate the image"/>
                    <ComboBox ItemsSource="{Binding ZoomOptions}"
                              SelectedItem="{Binding SelectedZoom}"
                              Width="64"
                              ToolTip.Tip="Digital zoom"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Camera controls (brightness / contrast / saturation) -->
        <Border DockPanel.Dock="Top" Padding="12,6" Background="#181818">
            <StackPanel Orientation="Horizontal" Spacing="24">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Bright" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
                    <Slider Value="{Binding Brightness}" Minimum="0" Maximum="255" Width="140"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Contrast" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
                    <Slider Value="{Binding Contrast}" Minimum="0" Maximum="255" Width="140"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Saturation" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
                    <Slider Value="{Binding Saturation}" Minimum="0" Maximum="255" Width="140"/>
                </StackPanel>
                <Button Content="Reset" Command="{Binding ResetCameraControlsCommand}" VerticalAlignment="Center"
                        ToolTip.Tip="Reset brightness / contrast / saturation to defaults"/>
            </StackPanel>
        </Border>

        <!-- Right panel: captures / effects -->
        <Border DockPanel.Dock="Right" Width="240" Background="#202020">
            <Grid>
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="8,10,8,6" ColumnDefinitions="*,*" ColumnSpacing="6">
                    <ToggleButton Grid.Column="0" Content="Captures" IsChecked="{Binding !ShowEffectsPanel}"/>
                    <ToggleButton Grid.Column="1" Content="Effects" IsChecked="{Binding ShowEffectsPanel}"/>
                </Grid>

                <StackPanel DockPanel.Dock="Top" Margin="8,0,8,4" Spacing="2"
                            IsVisible="{Binding ShowIntensitySlider}">
                    <TextBlock Text="Effect intensity" Foreground="#CCCCCC" FontSize="12"/>
                    <Slider Value="{Binding EffectIntensity}"
                            Minimum="{Binding SelectedEffect.IntensityMin}"
                            Maximum="{Binding SelectedEffect.IntensityMax}"
                            Width="220"/>
                </StackPanel>

                <TextBox DockPanel.Dock="Top" Margin="8,0,8,4" Watermark="Search effects…"
                         Text="{Binding EffectFilter}" IsVisible="{Binding ShowEffectsPanel}"/>

                <StackPanel DockPanel.Dock="Bottom" Margin="8" Spacing="6"
                            IsVisible="{Binding !ShowEffectsPanel}">
                    <Button Content="Play video" Command="{Binding PlaySelectedCommand}"/>
                    <Button Content="Rename" Command="{Binding RenameSelectedCommand}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Copy" Command="{Binding CopySelectedCommand}" HorizontalAlignment="Stretch"/>
                        <Button Content="Move" Command="{Binding MoveSelectedCommand}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <Button Content="Delete" Command="{Binding DeleteSelectedCommand}"/>
                </StackPanel>

                <!-- Effects gallery -->
                <ListBox ItemsSource="{Binding FilteredEffects}"
                         SelectedItem="{Binding SelectedEffect}"
                         IsVisible="{Binding ShowEffectsPanel}"
                         Background="Transparent" Margin="4,0,4,8">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:EffectOption">
                            <Border CornerRadius="4" Margin="3" Background="#40000000"
                                    BorderBrush="#33FFFFFF" BorderThickness="1">
                                <StackPanel>
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}" Width="100" Height="56"
                                               Stretch="UniformToFill"/>
                                        <ToggleButton IsChecked="{Binding IsFavorite}" Content="★"
                                                      FontSize="11" Width="24" Height="20" Padding="0"
                                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                                      Margin="2" ToolTip.Tip="Favorite — pin to the top">
                                            <ToggleButton.Styles>
                                                <Style Selector="ToggleButton">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </Style>
                                                <Style Selector="ToggleButton:unchecked">
                                                    <Setter Property="Foreground" Value="#B0B0B0"/>
                                                </Style>
                                                <Style Selector="ToggleButton:checked">
                                                    <Setter Property="Foreground" Value="#FFD700"/>
                                                </Style>
                                            </ToggleButton.Styles>
                                        </ToggleButton>
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" HorizontalAlignment="Center"
                                               FontSize="12" Margin="0,2"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Recent captures -->
                <ListBox ItemsSource="{Binding GalleryItems}"
                         SelectedItem="{Binding SelectedGalleryItem}"
                         DoubleTapped="OnGalleryDoubleTapped"
                         IsVisible="{Binding !ShowEffectsPanel}"
                         Background="Transparent" Margin="4,0,4,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:MediaItem">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,3">
                                <Border CornerRadius="3" ClipToBounds="True" Background="#40000000">
                                    <Image Source="{Binding Thumbnail}" Width="64" Height="36"
                                           Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                    <TextBlock Text="{Binding ModifiedAt, StringFormat='{}{0:MMM d, HH:mm}'}"
                                               FontSize="10" Foreground="#A0A0A0"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <TextBlock Text="No captures yet — take a photo or record a video."
                       Foreground="#888888" FontSize="12" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14"
                       IsVisible="{Binding ShowGalleryEmptyHint}"/>
            </Grid>
        </Border>

        <!-- Capture controls -->
        <Border DockPanel.Dock="Bottom" Padding="10" Background="#202020">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                <TextBlock Text="{Binding RecordingTime}" FontSize="16" FontFamily="monospace"
                           Foreground="#FF5252" IsVisible="{Binding IsRecording}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding RecordingSize}" FontSize="14" Foreground="#FF8A80"
                           IsVisible="{Binding IsRecording}" VerticalAlignment="Center"/>
                <Button Content="Take Photo" Command="{Binding TakePhotoCommand}"
                        FontSize="15" Padding="20,8"/>
                <ToggleButton IsChecked="{Binding MicEnabled}"
                              ToolTip.Tip="Record audio from the microphone">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#x1F3A4;"/>
                        <TextBlock Text="Mic"/>
                    </StackPanel>
                </ToggleButton>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Audio" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding SelectedAudioDevice}" Width="180"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Quality" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding SelectedQuality}" Width="86"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Max size" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding MaxSizeOptions}" SelectedItem="{Binding SelectedMaxSize}" Width="96"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Timer" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding TimerOptions}" SelectedItem="{Binding SelectedTimer}" Width="74"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Format" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding PhotoFormatOptions}" SelectedItem="{Binding SelectedPhotoFormat}" Width="68"/>
                </StackPanel>
                <Button Content="Record" Command="{Binding ToggleRecordingCommand}"
                        FontSize="15" Padding="20,8"/>
                <Button Content="{Binding BurstButtonText}" Command="{Binding ToggleBurstCommand}"
                        FontSize="15" Padding="20,8"/>
            </StackPanel>
        </Border>

        <!-- Preview area -->
        <Grid>
            <local:VideoSurface x:Name="VideoSurfaceControl" PointerWheelChanged="OnPreviewWheel"/>
            <Border Background="#80000000" CornerRadius="6" Padding="14,8"
                    IsVisible="{Binding IsBusy}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Looking for cameras…" Foreground="White"/>
            </Border>
            <TextBlock Text="{Binding StatusMessage}" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding !IsPreviewActive}"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="32"
                       MaxWidth="480"/>
            <TextBlock Text="{Binding CountdownText}" FontSize="96" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding IsCountingDown}">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="12" OffsetX="0" OffsetY="0" Opacity="0.9"/>
                </TextBlock.Effect>
            </TextBlock>
            <!-- White flash on photo capture -->
            <Border Background="White" IsVisible="{Binding IsFlashing}" IsHitTestVisible="False"/>

            <!-- Toast notification -->
            <Border Background="#E0222222" CornerRadius="6" Padding="16,10"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                    IsVisible="{Binding IsToastVisible}" IsHitTestVisible="False">
                <TextBlock Text="{Binding ToastText}" Foreground="White" FontSize="14"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
