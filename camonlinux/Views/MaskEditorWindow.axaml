<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:camonlinux.ViewModels"
        x:Class="camonlinux.Views.MaskEditorWindow"
        x:DataType="vm:MaskEditorViewModel"
        Title="Mask Editor"
        Width="560" Height="680"
        MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">
    <DockPanel>
        <!-- Global controls -->
        <Border DockPanel.Dock="Top" Padding="10,8" Background="#202020">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ToggleButton IsChecked="{Binding Enabled}" Content="Enable mask"/>
                    <TextBlock Text="Mode" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding MaskModeOptions}" SelectedIndex="{Binding ModeIndex}" Width="150"/>
                    <ToggleButton IsChecked="{Binding Invert}" Content="Invert"/>
                </StackPanel>
                <!-- Per-effect enable toggles: each mask type is off until enabled here. -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Effects:" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                    <ToggleButton IsChecked="{Binding ShapeEnabled}" Content="Shape"/>
                    <ToggleButton IsChecked="{Binding GradientEnabled}" Content="Gradient"/>
                    <ToggleButton IsChecked="{Binding ChromaEnabled}" Content="Chroma"/>
                    <ToggleButton IsChecked="{Binding SvgEnabled}" Content="SVG"/>
                    <ToggleButton IsChecked="{Binding SourceEnabled}" Content="Source"/>
                    <ToggleButton IsChecked="{Binding BsmEnabled}" Content="BSM"/>
                    <ToggleButton IsChecked="{Binding FeatherEnabled}" Content="Feather"/>
                    <ToggleButton IsChecked="{Binding AdjustmentEnabled}" Content="Adjust"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TabControl Margin="8">
            <!-- ============ SHAPE ============ -->
            <TabItem Header="Shape">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8" Margin="8">
                        <ComboBox ItemsSource="{Binding ShapeOptions}" SelectedIndex="{Binding ShapeIndex}" HorizontalAlignment="Stretch"/>

                        <ToggleButton IsChecked="{Binding Shape.Invert}" Content="Invert mask"/>

                        <TextBlock Text="Position / Scale" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Center X" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                                <Slider Value="{Binding Shape.CenterX}" Minimum="0" Maximum="100" Width="120"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Center Y" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                                <Slider Value="{Binding Shape.CenterY}" Minimum="0" Maximum="100" Width="120"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Scale type" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding ScaleTypeOptions}" SelectedIndex="{Binding ScaleTypeIndex}" Width="86"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Scale" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                                <Slider Value="{Binding Shape.Scale}" Minimum="1" Maximum="100" Width="120"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsWidthScale}">
                                <TextBlock Text="Width px" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Shape.WidthPx}" Width="70"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsHeightScale}">
                                <TextBlock Text="Height px" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Shape.HeightPx}" Width="70"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Pos X" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Value="{Binding Shape.PositionX}" Minimum="-500" Maximum="500" Width="110"/>
                            <TextBlock Text="Pos Y" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Value="{Binding Shape.PositionY}" Minimum="-500" Maximum="500" Width="110"/>
                            <TextBlock Text="Scale" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Value="{Binding Shape.SceneScale}" Minimum="0.1" Maximum="5" Width="110"/>
                            <Button Content="Recenter" Command="{Binding RecenterShapeCommand}"/>
                            <ToggleButton IsChecked="{Binding Shape.FrameCheck}" Content="Frame check"/>
                        </StackPanel>

                        <!-- Rectangle -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsRectangle}">
                            <TextBlock Text="Rectangle" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                            <ComboBox ItemsSource="{Binding CornerRadiusTypeOptions}" SelectedIndex="{Binding CornerTypeIndex}" Width="120"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Corner radius" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                                <Slider Value="{Binding Shape.CornerRadius}" Minimum="0" Maximum="300" Width="140"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCustomCorners}">
                                <TextBlock Text="TL" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Shape.CornerTl}" Minimum="0" Maximum="300" Width="90"/>
                                <TextBlock Text="TR" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Shape.CornerTr}" Minimum="0" Maximum="300" Width="90"/>
                                <TextBlock Text="BL" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Shape.CornerBl}" Minimum="0" Maximum="300" Width="90"/>
                                <TextBlock Text="BR" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Shape.CornerBr}" Minimum="0" Maximum="300" Width="90"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Circle -->
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCircle}">
                            <TextBlock Text="Circle radius %" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Value="{Binding Shape.Radius}" Minimum="1" Maximum="200" Width="160"/>
                        </StackPanel>

                        <!-- Ellipse -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsEllipse}">
                            <TextBlock Text="Ellipse" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Width" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Shape.EllipseWidth}" Minimum="20" Maximum="400" Width="120"/>
                                <TextBlock Text="Height" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Shape.EllipseHeight}" Minimum="20" Maximum="400" Width="120"/>
                                <TextBlock Text="Rot°" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Shape.EllipseRotation}" Minimum="-180" Maximum="180" Width="120"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Regular polygon -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsPolygon}">
                            <TextBlock Text="Regular Polygon" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Sides" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding Shape.Sides}" Minimum="3" Maximum="24" Width="70"/>
                                <TextBlock Text="Radius %" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Shape.PolygonRadius}" Minimum="1" Maximum="200" Width="100"/>
                                <TextBlock Text="Corner" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Shape.PolygonCornerRadius}" Minimum="0" Maximum="120" Width="100"/>
                                <TextBlock Text="Rot°" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Shape.PolygonRotation}" Minimum="-180" Maximum="180" Width="100"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Star -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsStar}">
                            <TextBlock Text="Star" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Points" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding Shape.StarPoints}" Minimum="3" Maximum="24" Width="70"/>
                                <TextBlock Text="Outer %" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Shape.StarOuter}" Minimum="1" Maximum="200" Width="100"/>
                                <TextBlock Text="Inner %" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Shape.StarInner}" Minimum="1" Maximum="200" Width="100"/>
                                <TextBlock Text="Rot°" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Shape.StarRotation}" Minimum="-180" Maximum="180" Width="100"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Heart -->
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsHeart}">
                            <TextBlock Text="Heart size %" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Value="{Binding Shape.HeartSize}" Minimum="1" Maximum="200" Width="160"/>
                            <TextBlock Text="Rot°" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Shape.HeartRotation}" Minimum="-180" Maximum="180" Width="120"/>
                        </StackPanel>

                        <!-- Superformula -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsSuperformula}">
                            <TextBlock Text="Superformula" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                            <ComboBox ItemsSource="{Binding SuperformulaModeOptions}" SelectedIndex="{Binding SuperModeIndex}" Width="140"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="a" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Shape.A}" Minimum="0.1" Maximum="5" Width="90"/>
                                <TextBlock Text="b" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Shape.B}" Minimum="0.1" Maximum="5" Width="90"/>
                                <TextBlock Text="m" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Shape.M}" Minimum="1" Maximum="16" Width="90"/>
                                <TextBlock Text="n1" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Shape.N1}" Minimum="0.1" Maximum="10" Width="90"/>
                                <TextBlock Text="n2" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Shape.N2}" Minimum="0.1" Maximum="10" Width="90"/>
                                <TextBlock Text="n3" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Shape.N3}" Minimum="0.1" Maximum="10" Width="90"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Feather" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding FeatherTypeOptions}" SelectedIndex="{Binding FeatherTypeIndex}" Width="96"/>
                            <Slider Value="{Binding Shape.FeatherAmount}" Minimum="1" Maximum="100" Width="120"/>
                        </StackPanel>

                        <Button Content="Reset shape" Command="{Binding ResetShapeCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ GRADIENT ============ -->
            <TabItem Header="Gradient">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10" Margin="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Width px" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Value="{Binding Gradient.Width}" Minimum="10" Maximum="1000" Width="200"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Position" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Value="{Binding Gradient.Position}" Minimum="-500" Maximum="500" Width="200"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Rotation°" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Value="{Binding Gradient.Rotation}" Minimum="-180" Maximum="180" Width="200"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ToggleButton IsChecked="{Binding Gradient.Invert}" Content="Invert"/>
                            <ToggleButton IsChecked="{Binding Gradient.DebugLines}" Content="Debug lines"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ CHROMA KEY ============ -->
            <TabItem Header="Chroma">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8" Margin="8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ToggleButton IsChecked="{Binding Chroma.ShowMatte}" Content="Show matte"/>
                            <ToggleButton IsChecked="{Binding Chroma.DoubleColor}" Content="Double color"/>
                        </StackPanel>

                        <TextBlock Text="Key color (RGB)" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="R" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Chroma.KeyR}" Minimum="0" Maximum="255" Width="100"/>
                            <TextBlock Text="G" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Chroma.KeyG}" Minimum="0" Maximum="255" Width="100"/>
                            <TextBlock Text="B" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Chroma.KeyB}" Minimum="0" Maximum="255" Width="100"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Chroma.DoubleColor}">
                            <TextBlock Text="R2" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Chroma.KeyR2}" Minimum="0" Maximum="255" Width="100"/>
                            <TextBlock Text="G2" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Chroma.KeyG2}" Minimum="0" Maximum="255" Width="100"/>
                            <TextBlock Text="B2" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/><Slider Value="{Binding Chroma.KeyB2}" Minimum="0" Maximum="255" Width="100"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Similarity" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Row="0" Grid.Column="1" Value="{Binding Chroma.Similarity}" Minimum="0" Maximum="100" Width="150"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Smoothness" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Row="0" Grid.Column="3" Value="{Binding Chroma.Smoothness}" Minimum="0" Maximum="100" Width="150"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Spill" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Row="1" Grid.Column="1" Value="{Binding Chroma.SpillReduction}" Minimum="0" Maximum="100" Width="150"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Opacity" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Row="1" Grid.Column="3" Value="{Binding Chroma.Opacity}" Minimum="0" Maximum="100" Width="150"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Contrast" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Row="2" Grid.Column="1" Value="{Binding Chroma.Contrast}" Minimum="-100" Maximum="100" Width="150"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Brightness" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Row="2" Grid.Column="3" Value="{Binding Chroma.Brightness}" Minimum="-100" Maximum="100" Width="150"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Gamma" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Value="{Binding Chroma.Gamma}" Minimum="50" Maximum="150" Width="200"/>
                        </StackPanel>

                        <ToggleButton IsChecked="{Binding Chroma.Invert}" Content="Invert mask"/>

                        <TextBlock Text="Super Key (experimental)" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                        <ToggleButton IsChecked="{Binding Chroma.SuperKey}" Content="Enable Super Key"/>
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="6" IsVisible="{Binding Chroma.SuperKey}">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="K" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Row="0" Grid.Column="1" Value="{Binding Chroma.K}" Minimum="0.05" Maximum="4" Width="200"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="K2" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Row="1" Grid.Column="1" Value="{Binding Chroma.K2}" Minimum="0.05" Maximum="4" Width="200"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Veil" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Row="2" Grid.Column="1" Value="{Binding Chroma.Veil}" Minimum="0" Maximum="100" Width="200"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ SVG ============ -->
            <TabItem Header="SVG">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8" Margin="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Load SVG file…" Click="OnLoadSvgFile"/>
                            <TextBlock Text="Paste SVG below, or load a file." Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox Text="{Binding Svg.SvgText}" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="140" FontFamily="monospace" FontSize="11"
                                 PlaceholderText="&lt;svg …&gt; &lt;path d=&quot;…&quot;/&gt; &lt;/svg&gt;"/>
                        <ToggleButton IsChecked="{Binding Svg.Invert}" Content="Invert mask"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Scale by" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding SvgScaleByOptions}" SelectedIndex="{Binding SvgScaleByIndex}" Width="100"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Width" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Svg.Width}" Width="70"/>
                            <TextBlock Text="Height" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Svg.Height}" Width="70"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Pos X" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Value="{Binding Svg.PositionX}" Minimum="-1000" Maximum="1000" Width="120"/>
                            <TextBlock Text="Pos Y" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Value="{Binding Svg.PositionY}" Minimum="-1000" Maximum="1000" Width="120"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ SOURCE ============ -->
            <TabItem Header="Source">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8" Margin="8">
                        <TextBlock Text="Use a second webcam as the mask."
                                   TextWrapping="Wrap" Foreground="#AAAAAA" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Device" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Source.Device}" Width="140" PlaceholderText="/dev/video2"/>
                            <ToggleButton IsChecked="{Binding Source.Invert}" Content="Invert"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Channel" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding SourceChannelOptions}" SelectedIndex="{Binding SourceChannelIndex}" Width="150"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Filter" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SourceFilterOptions}" SelectedIndex="{Binding SourceFilterIndex}" Width="150"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Compression" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SourceCompressionOptions}" SelectedIndex="{Binding SourceCompressionIndex}" Width="150"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Multiplier" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Row="3" Grid.Column="1" Value="{Binding Source.Multiplier}" Minimum="0" Maximum="4" Width="200"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Threshold" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Row="4" Grid.Column="1" Value="{Binding Source.Threshold}" Minimum="0" Maximum="255" Width="200"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Range" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Slider Value="{Binding Source.RangeMin}" Minimum="0" Maximum="255" Width="90"/>
                                <Slider Value="{Binding Source.RangeMax}" Minimum="0" Maximum="255" Width="90"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Scale by" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding SourceScaleByOptions}" SelectedIndex="{Binding SourceScaleByIndex}" Width="110"/>
                            <TextBlock Text="%" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Value="{Binding Source.Scale}" Minimum="1" Maximum="300" Width="100"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="W/H" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Source.Width}" Width="60"/>
                            <TextBox Text="{Binding Source.Height}" Width="60"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Offset" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Value="{Binding Source.OffsetX}" Minimum="-1000" Maximum="1000" Width="100"/>
                            <Slider Value="{Binding Source.OffsetY}" Minimum="-1000" Maximum="1000" Width="100"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Boundary" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding SourceBoundaryOptions}" SelectedIndex="{Binding SourceBoundaryIndex}" Width="110"/>
                            <TextBlock Text="Rot" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Value="{Binding Source.Rotation}" Minimum="0" Maximum="270" Width="100"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Align" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding SourceAlignmentOptions}" SelectedIndex="{Binding SourceAlignmentIndex}" Width="80"/>
                            <TextBlock Text="Pos" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Value="{Binding Source.PositionX}" Minimum="-1000" Maximum="1000" Width="90"/>
                            <Slider Value="{Binding Source.PositionY}" Minimum="-1000" Maximum="1000" Width="90"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ BSM ============ -->
            <TabItem Header="BSM">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8" Margin="8">
                        <TextBlock Text="Alpha wipe: reveals content as the scene changes from a stored background."
                                   TextWrapping="Wrap" Foreground="#AAAAAA" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Capture background" Classes="accent" Command="{Binding CaptureBsmBackgroundCommand}"/>
                            <Button Content="Reset background" Command="{Binding ResetBsmBackgroundCommand}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Threshold" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Value="{Binding Bsm.Threshold}" Minimum="0" Maximum="255" Width="200"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Fade-out time (s)" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Value="{Binding Bsm.FadeOutTime}" Minimum="0.1" Maximum="5" Width="200"/>
                        </StackPanel>
                        <ToggleButton IsChecked="{Binding Bsm.FreezeFrame}" Content="Freeze frame (no live updates)"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ ADJUSTMENT ============ -->
            <TabItem Header="Adjust">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8" Margin="8">
                        <TextBlock Text="Brightness" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Text="Min" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Value="{Binding Adjustment.BrightnessMin}" Minimum="-100" Maximum="100" Width="180"/>
                            <TextBlock Grid.Column="2" Text="Max" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Column="3" Value="{Binding Adjustment.BrightnessMax}" Minimum="-100" Maximum="100" Width="180"/>
                        </Grid>
                        <TextBlock Text="Contrast" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Text="Min" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Value="{Binding Adjustment.ContrastMin}" Minimum="-100" Maximum="100" Width="180"/>
                            <TextBlock Grid.Column="2" Text="Max" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Column="3" Value="{Binding Adjustment.ContrastMax}" Minimum="-100" Maximum="100" Width="180"/>
                        </Grid>
                        <TextBlock Text="Saturation" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Text="Min" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Value="{Binding Adjustment.SaturationMin}" Minimum="-100" Maximum="100" Width="180"/>
                            <TextBlock Grid.Column="2" Text="Max" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Column="3" Value="{Binding Adjustment.SaturationMax}" Minimum="-100" Maximum="100" Width="180"/>
                        </Grid>
                        <TextBlock Text="Hue shift" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Text="Min" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Value="{Binding Adjustment.HueShiftMin}" Minimum="-180" Maximum="180" Width="180"/>
                            <TextBlock Grid.Column="2" Text="Max" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Column="3" Value="{Binding Adjustment.HueShiftMax}" Minimum="-180" Maximum="180" Width="180"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Effect ordering: the pipeline applies effects top-to-bottom. -->
        <Border DockPanel.Dock="Bottom" Padding="10,8" Background="#202020">
            <StackPanel Spacing="6">
                <TextBlock Text="Effect order (applied top → bottom)" FontWeight="SemiBold" Foreground="#CCCCCC" FontSize="12"/>
                <ItemsControl ItemsSource="{Binding EffectItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                <TextBlock Text="{Binding Name}" Width="130" VerticalAlignment="Center" Foreground="White"/>
                                <Button Content="▲" Command="{Binding MoveUpCommand}" CommandParameter="{Binding}" Padding="8,2"/>
                                <Button Content="▼" Command="{Binding MoveDownCommand}" CommandParameter="{Binding}" Padding="8,2"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DockPanel>
</Window>
