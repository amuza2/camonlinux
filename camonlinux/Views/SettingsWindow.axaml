<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="camonlinux.Views.SettingsWindow"
        Title="Settings"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock Text="Photo directory" FontWeight="SemiBold"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowsePhoto" Margin="6,0,0,0"/>
            <TextBox x:Name="PhotoDirBox" IsReadOnly="True"/>
        </DockPanel>

        <TextBlock Text="Video directory" FontWeight="SemiBold"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseVideo" Margin="6,0,0,0"/>
            <TextBox x:Name="VideoDirBox" IsReadOnly="True"/>
        </DockPanel>

        <TextBlock Text="Burst" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="BurstIntervalBox" Width="90" ToolTip.Tip="Time between burst photos"/>
            <ComboBox x:Name="BurstCountBox" Width="130" ToolTip.Tip="Number of burst photos (Unlimited = until stopped)"/>
        </StackPanel>

        <TextBlock Text="Virtual webcam background" FontWeight="SemiBold"/>
        <ComboBox x:Name="VirtualCamBgBox" Width="140"
                  ToolTip.Tip="Fills the masked-out (transparent) areas of the virtual webcam — pick Green to chroma-key in Discord/OBS"/>

        <TextBlock Text="Other options (resolution, timer, quality, format, zoom, camera controls, …) are in the main window." 
                   Foreground="#999999" FontSize="12" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Cancel" Click="OnCancel" MinWidth="80"/>
            <Button Content="Save" Classes="accent" Click="OnSave" MinWidth="80"/>
        </StackPanel>
    </StackPanel>
</Window>
