<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="camonlinux.App"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:local="using:camonlinux"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="True" />

        <!-- App icon for every window (the main window also sets it explicitly in
             MainWindow.axaml, since that is the one the taskbar shows). -->
        <Style Selector="Window">
            <Setter Property="Icon" Value="/Assets/webcam.ico" />
        </Style>

        <!-- Right-panel resize grip: invisible until hovered, so it reads as an edge
             you can grab without adding a permanent line to the layout. -->
        <Style Selector="Border.resize-grip:pointerover">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
    </Application.Styles>
</Application>