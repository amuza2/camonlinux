<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="camonlinux.App"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:local="using:camonlinux"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="True" />

        <!-- App icon for every window (the main window also sets it explicitly in
             MainWindow.axaml, since that is the one the taskbar shows). -->
        <Style Selector="Window">
            <Setter Property="Icon" Value="/Assets/webcam.ico" />
        </Style>

        <!-- Right-panel resize grip: invisible until hovered, so it reads as an edge
             you can grab without adding a permanent line to the layout. -->
        <Style Selector="Border.resize-grip:pointerover">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>

        <!-- Numeric readout shown beside every camera-control slider (nine of them, so
             the styling lives here rather than being repeated inline). It binds to the
             same property the slider writes to, so it tracks the drag and also reflects
             changes from Reset or from restored settings. Fixed width + right alignment
             stops the row shifting as the number gains or loses a digit. -->
        <Style Selector="TextBlock.slider-value">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="34" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <!-- While the matching "Auto" toggle is on, the manual value is stored but not
             applied — dim it so that is visible. -->
        <Style Selector="TextBlock.slider-value:disabled">
            <Setter Property="Foreground" Value="#6E6E6E" />
        </Style>

        <!-- Status indicator for modes that only live in a menu (mask, virtual camera),
             so their state is still visible at a glance. -->
        <Style Selector="Border.status-pill">
            <Setter Property="Background" Value="#33FF9800" />
            <Setter Property="BorderBrush" Value="#66FF9800" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.status-pill TextBlock">
            <Setter Property="Foreground" Value="#FFCC80" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Application.Styles>
</Application>