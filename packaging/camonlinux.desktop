[Desktop Entry]
Type=Application
Name=camonlinux
GenericName=Webcam Application
Comment=Take photos and record videos with your webcam
Exec=camonlinux
Icon=camonlinux
Terminal=false
# Exactly one main category is allowed. AudioVideo is the main one and
# AudioVideoEditing a sub-category of it; also listing Graphics made the entry
# show up twice in some application menus, and appimagetool warned about it.
Categories=AudioVideo;AudioVideoEditing;
StartupNotify=true
Keywords=webcam;camera;photo;video;record;
